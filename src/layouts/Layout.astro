---
interface Props {
  title?:       string;
  description?: string;
  showNav?:     boolean;
  wide?:        boolean;
  /** Web-app manifest: decides what "Add to Home Screen" opens. Budget by default; the wife page passes its own. */
  manifest?:    string;
  appTitle?:    string;
}

const {
  title       = 'LimeTiramisu',
  description = 'Your household financial planner.',
  showNav     = true,
  wide        = false,
  manifest    = '/manifest-budget.json',
  appTitle    = 'Budget',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    {/* black-translucent lets the home-screen app draw under the status bar — on the folded
        iPhone Duo that's the right-side column, where the tab bar goes (see data-side-strip).
        The status icons turn white, so .status-backdrop-* paints dark behind them. */}
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#f0f1e8" />
    <meta name="color-scheme" content="light" />
    <meta name="darkreader-lock" />
    <meta name="apple-mobile-web-app-title" content={appTitle} />
    <link rel="manifest" href={manifest} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} — LimeTiramisu</title>

    <script is:inline>
      // iPhone Duo fold/unfold in the home-screen app: iOS 27 picks up the new width but can
      // keep the old viewport height, leaving the fixed tab bar stuck mid-screen until the
      // phone is rotated. Rotation fixes it by re-applying the viewport, so re-apply the
      // viewport meta ourselves whenever the width changes, then re-lay out the tab bar.
      // Resize events around a fold are unreliable, so re-check as things settle.
      (function () {
        var meta = document.querySelector('meta[name="viewport"]');
        var base = meta && meta.content;
        var lastW = window.innerWidth;
        var standalone = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
        // Side status column (folded Duo, or unfolded sideways): a right inset of 64px+ with
        // none on the left. A slab iPhone held sideways has insets on both sides, so it doesn't
        // match. Home-screen app only — in Safari that column holds Safari's own buttons.
        function syncStrip() {
          if (!document.body) return;
          var probe = document.createElement('div');
          probe.style.cssText = 'position:fixed;visibility:hidden;padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right)';
          document.body.appendChild(probe);
          var cs = getComputedStyle(probe);
          var l = parseFloat(cs.paddingLeft) || 0, r = parseFloat(cs.paddingRight) || 0;
          probe.remove();
          var root = document.documentElement;
          if (standalone && r >= 64 && l < 16) {
            root.setAttribute('data-side-strip', '');
            root.style.setProperty('--strip-w', r + 'px');
          } else {
            root.removeAttribute('data-side-strip');
          }
        }
        document.addEventListener('DOMContentLoaded', syncStrip);
        addEventListener('resize', syncStrip);
        function relayoutNav() {
          var nav = document.querySelector('.mobile-nav');
          if (nav) { nav.style.display = 'none'; void nav.offsetHeight; nav.style.display = ''; }
        }
        function kick() {
          syncStrip();
          if (meta) {
            meta.content = base + ', minimum-scale=1'; // equivalent value; the change forces a recompute
            requestAnimationFrame(function () { meta.content = base; relayoutNav(); });
          }
          relayoutNav();
          window.scrollTo(window.scrollX, window.scrollY);
        }
        function settle() {
          var w = window.innerWidth;
          if (!isFinite(w) || w <= 0 || w === lastW) return; // garbage, or a height-only change (keyboard)
          lastW = w;
          // iOS may still be mid-transition on the first event; nudge again as it settles.
          kick(); setTimeout(kick, 150); setTimeout(kick, 600); setTimeout(kick, 1200);
        }
        addEventListener('resize', settle);
        addEventListener('orientationchange', settle);
        addEventListener('pageshow', settle);
        if (window.visualViewport) visualViewport.addEventListener('resize', settle);
        document.addEventListener('visibilitychange', function () { if (!document.hidden) settle(); });
      })();
    </script>

    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=inter:300,400,500,600,700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root { color-scheme: only light; }

      /* Force light palette even if OS/browser requests dark */
      @media (prefers-color-scheme: dark) {
        :root { color-scheme: light; }
        html  { background-color: #f0f1e8 !important; color: #1c1917 !important; }
        body  { background-color: #f0f1e8 !important; }
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; }
      /* Nothing parked off-screen (e.g. the swipe peek) may widen the page into a sideways pan. */
      html, body { overflow-x: clip; }
      body { font-family: 'Inter', system-ui, sans-serif; }
      .tabular-nums { font-variant-numeric: tabular-nums; }
      button, a { transition: opacity 0.15s, color 0.15s, background-color 0.15s; }

      /* Mobile: bottom nav spacing */
      @supports (padding-bottom: env(safe-area-inset-bottom)) {
        .mobile-nav {
          padding-bottom: env(safe-area-inset-bottom);
          padding-left:   env(safe-area-inset-left);
          padding-right:  env(safe-area-inset-right);
        }
      }

      /* Status bar backdrops. With black-translucent the page runs under the status bar and
         iOS draws its icons white, so they need something dark behind them. Home-screen app
         only; zero-size wherever there's no inset. */
      .status-backdrop-top, .status-backdrop-side { display: none; position: fixed; background: #292524; }
      @media (display-mode: standalone) {
        .status-backdrop-top { display: block; top: 0; left: 0; right: 0; height: env(safe-area-inset-top); z-index: 55; }
      }

      /* Side status column (set by the head script): the tab bar moves into it, under the clock. */
      html[data-side-strip] .status-backdrop-side { display: block; top: 0; bottom: 0; right: 0; width: var(--strip-w); z-index: 45; }
      html[data-side-strip] .mobile-nav {
        display: block; top: 176px; bottom: 0; left: auto; right: 0; width: var(--strip-w);
        padding: 0 0 env(safe-area-inset-bottom); border-top: 0; background: transparent;
      }
      html[data-side-strip] .mobile-nav > div { flex-direction: column; justify-content: flex-start; gap: 1.25rem; padding: 0; }
      html[data-side-strip] .mobile-nav a { color: #d6d3d1; }
      html[data-side-strip] main { padding-bottom: 1.5rem; }
      html[data-side-strip] #save-error-toast { bottom: 1.5rem; }

      /* Checkbox accent for light theme */
      input[type="checkbox"] { accent-color: #65a30d; }

      /* Promote the sticky header to its own GPU layer so Safari
         doesn't re-rasterize page content under it every frame. Not the
         mobile nav: iOS keeps its stale layer when the iPhone Duo folds/unfolds. */
      header.sticky { will-change: transform; }

      /* Skip rendering/paint of offscreen section cards — major scroll
         perf win on long pages. Browser reserves space via contain-intrinsic-size. */
      .cv-auto {
        content-visibility: auto;
        contain-intrinsic-size: 1px 600px;
      }
    </style>
  </head>

  <body class="h-full bg-surface text-stone-800 antialiased">
    <div class="status-backdrop-top" aria-hidden="true"></div>
    <div class="status-backdrop-side" aria-hidden="true"></div>
    {showNav && (
      <>
        {/* Desktop nav */}
        <header class="sticky top-0 z-50 border-b border-surface-border bg-surface hidden sm:block touch:hidden">
          <nav class={`mx-auto flex items-center justify-between px-4 py-3 ${wide ? 'max-w-7xl' : 'max-w-5xl'}`}>
            <a href="/" class="flex items-center gap-2 text-sm font-bold tracking-tight text-stone-800 hover:opacity-80">
              <!-- Tiramisu slice icon: cocoa top / cream / espresso ladyfinger / lime zest dot -->
              <svg width="22" height="20" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <!-- ladyfinger / espresso base -->
                <rect x="1" y="13" width="20" height="6" rx="2" fill="#92400e"/>
                <!-- cream layer -->
                <rect x="1" y="6" width="20" height="7" fill="#fef3e2"/>
                <!-- cocoa-dusted top -->
                <rect x="1" y="1" width="20" height="5" rx="1.5" fill="#6b3a1f"/>
                <!-- lime zest accent -->
                <circle cx="17" cy="3.5" r="2" fill="#65a30d"/>
                <circle cx="17" cy="3.5" r="1" fill="#84cc16"/>
              </svg>
              LimeTiramisu
            </a>

            <div class="flex items-center gap-1">
              <a href="/budget"
                class="rounded-lg px-3 py-1.5 text-sm text-stone-500 hover:bg-surface-hover hover:text-stone-800"
              >Budget</a>
              <a href="/budget/year"
                class="rounded-lg px-3 py-1.5 text-sm text-stone-500 hover:bg-surface-hover hover:text-stone-800"
              >Year</a>
              <a href="/budget/recurring"
                class="rounded-lg px-3 py-1.5 text-sm text-stone-500 hover:bg-surface-hover hover:text-stone-800"
              >Recurring</a>
              <a href="/dashboard"
                class="rounded-lg px-3 py-1.5 text-sm text-stone-500 hover:bg-surface-hover hover:text-stone-800"
              >Impact</a>
              <a href="/analyze"
                class="rounded-lg px-3 py-1.5 text-sm text-stone-500 hover:bg-surface-hover hover:text-stone-800"
              >Analyze</a>
              <a href="/connect"
                class="rounded-lg px-3 py-1.5 text-sm text-stone-500 hover:bg-surface-hover hover:text-stone-800"
              >Accounts</a>
              <a href="/food"
                class="rounded-lg px-3 py-1.5 text-sm text-stone-500 hover:bg-surface-hover hover:text-stone-800"
              >Food</a>
              <form action="/api/auth/logout" method="POST" class="ml-2">
                <button type="submit"
                  class="rounded-lg border border-surface-border px-3 py-1.5 text-xs text-stone-400 hover:border-stone-400 hover:text-stone-600"
                >Sign out</button>
              </form>
            </div>
          </nav>
        </header>

        {/* Mobile bottom tab bar */}
        <nav class="mobile-nav fixed bottom-0 left-0 right-0 z-50 border-t border-surface-border bg-surface-card sm:hidden touch:block">
          <div class="flex items-center justify-around px-2 py-2">
            <a href="/budget" class="flex flex-col items-center gap-0.5 px-2 py-1 text-stone-500 hover:text-brand-green">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 7h6m-6 4h6m-6 4h4M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"/></svg>
              <span class="text-[10px] font-medium">Budget</span>
            </a>
            <a href="/budget/year" class="flex flex-col items-center gap-0.5 px-2 py-1 text-stone-500 hover:text-brand-green">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span class="text-[10px] font-medium">Year</span>
            </a>
            <a href="/dashboard" class="flex flex-col items-center gap-0.5 px-2 py-1 text-stone-500 hover:text-brand-green">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <span class="text-[10px] font-medium">Impact</span>
            </a>
            <a href="/analyze" class="flex flex-col items-center gap-0.5 px-2 py-1 text-stone-500 hover:text-brand-green">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              <span class="text-[10px] font-medium">Analyze</span>
            </a>
            <a href="/connect" class="flex flex-col items-center gap-0.5 px-2 py-1 text-stone-500 hover:text-brand-green">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
              <span class="text-[10px] font-medium">Accounts</span>
            </a>
          </div>
        </nav>
      </>
    )}

    {/* Side padding clears the camera housing when the unfolded iPhone Duo is held landscape (viewport-fit=cover). */}
    <main class={`mx-auto pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] pt-[calc(1.25rem+env(safe-area-inset-top))] pb-24 sm:pb-6 touch:pb-24 ${wide ? 'max-w-7xl' : 'max-w-5xl'}`}>
      <slot />
    </main>

    <script>
      // Viewport readout: triple-tap a page title. The home-screen app has no URL bar or
      // inspector, and its sizes differ from Safari's — this shows what iOS really reports.
      let taps = 0, tapTimer: ReturnType<typeof setTimeout> | undefined, panel: HTMLElement | null = null, tick: ReturnType<typeof setInterval> | undefined;
      const inset = (side: string) => {
        const probe = document.createElement('div');
        probe.style.cssText = `position:fixed;visibility:hidden;padding-top:env(safe-area-inset-${side})`;
        document.body.appendChild(probe);
        const v = getComputedStyle(probe).paddingTop;
        probe.remove();
        return v;
      };
      const render = () => {
        if (!panel) return;
        const vv = window.visualViewport;
        const mq = (q: string) => (matchMedia(q).matches ? 'yes' : 'no');
        panel.textContent = [
          `inner     ${innerWidth} × ${innerHeight}`,
          `visual    ${vv ? `${Math.round(vv.width)} × ${Math.round(vv.height)} @${vv.scale}` : 'n/a'}`,
          `screen    ${screen.width} × ${screen.height}  dpr ${devicePixelRatio}`,
          `standalone ${(navigator as any).standalone ? 'yes' : 'no'}  display-mode ${mq('(display-mode: standalone)')}`,
          `touch     ${mq('(hover: none) and (pointer: coarse)')}`,
          `side-strip ${document.documentElement.hasAttribute("data-side-strip") ? "ON" : "off"}`,
          `client    ${document.documentElement.clientWidth} × ${document.documentElement.clientHeight}`,
          `nav       ${(() => { const r = document.querySelector('.mobile-nav')?.getBoundingClientRect(); return r ? `top ${Math.round(r.top)} bottom ${Math.round(r.bottom)}` : 'n/a'; })()}`,
          `safe-area t ${inset('top')} r ${inset('right')} b ${inset('bottom')} l ${inset('left')}`,
          '', 'tap to close',
        ].join('\n');
      };
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('h1')) return;
        clearTimeout(tapTimer);
        tapTimer = setTimeout(() => { taps = 0; }, 600);
        if (++taps < 3) return;
        taps = 0;
        panel = document.createElement('pre');
        panel.className = 'fixed left-2 right-2 top-2 z-[70] whitespace-pre-wrap rounded-lg bg-stone-900/90 p-3 font-mono text-[11px] leading-snug text-lime-200';
        panel.addEventListener('click', () => { clearInterval(tick); panel?.remove(); panel = null; });
        document.body.appendChild(panel);
        render();
        tick = setInterval(render, 500); // live, so a fold/unfold shows up without reopening
      });
    </script>
  </body>
</html>
