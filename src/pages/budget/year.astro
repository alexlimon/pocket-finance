---
import Layout from '../../layouts/Layout.astro';
import { verifySession } from '../../lib/auth';
import { getClient } from '../../lib/db';
import { fmt, totalIncome, prevMonth, LATEST_INVESTMENTS_SQL, type MonthlySummary, type CCCharge } from '../../lib/budget';
import { readMonthBalances } from '../../lib/recompute';
import { amortizeBigPurchases } from '../../lib/insights';

const env = Astro.locals.runtime.env;
if (!(await verifySession(Astro.request, env))) return Astro.redirect('/login');

const year = Astro.url.searchParams.get('year') ?? String(new Date().getFullYear());
const months = Array.from({ length: 12 }, (_, i) => `${year}-${String(i + 1).padStart(2, '0')}`);
const MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

const client = getClient(env);
let summaries: Record<string, MonthlySummary> = {};
let balancesByMonth: Awaited<ReturnType<typeof readMonthBalances>> = new Map();
let investmentsSeed = 0;
// billsByMonth[month] = list of non-CC recurring bills with resolved amounts
let billsByMonth: Record<string, { id: string; name: string; actual_amount: number; is_cc: number }[]> = {};
let ccByMonth: Record<string, CCCharge[]> = {};
let ccVariableByMonth: Record<string, number> = {};
let cashIncomeByMonth: Record<string, number> = {};
let cashExpenseByMonth: Record<string, number> = {};
let bigPurchaseRows: { category_id: string | null; amount: number; month: string }[] = [];
let billingEndDay = 18;

try {
  const [sumRes, configRes, payRes, ccRes, ccVarRes, bigRes, cashIncomeRes, ccSettingsRes, cashExpenseRes] = await Promise.all([
    client.execute({ sql: `SELECT * FROM monthly_summary WHERE month LIKE ?`, args: [`${year}-%`] }),
    // All non-CC recurring bills (the defaults)
    client.execute({
      sql: `SELECT id, name, monthly_target, is_cc_default, start_month, end_month FROM budget_config WHERE is_recurring = 1 AND is_cc_default = 0`,
      args: [],
    }),
    // All bill_payments for this year (paid or unpaid, but not skipped)
    client.execute({
      sql: `SELECT bill_id, month, amount, is_paid, is_cc, is_skipped FROM bill_payments WHERE month LIKE ?`,
      args: [`${year}-%`],
    }),
    client.execute({ sql: `SELECT * FROM cc_charges WHERE month LIKE ?`, args: [`${year}-%`] }),
    client.execute({ sql: `SELECT month, SUM(amount) as total FROM cc_variable_spend WHERE month LIKE ? OR month = ? GROUP BY month`, args: [`${year}-%`, `${Number(year)-1}-12`] }),
    // Big purchases for the year (for amortization panel)
    client.execute({
      sql: `SELECT category_id, amount, month FROM cc_charges WHERE month LIKE ? AND is_big_purchase = 1`,
      args: [`${year}-%`],
    }),
    client.execute({ sql: `SELECT month, SUM(amount) as total FROM cash_expenses WHERE month LIKE ? AND type = 'income' GROUP BY month`, args: [`${year}-%`] }),
    client.execute({ sql: `SELECT MIN(billing_end_day) as day FROM cc_settings`, args: [] }),
    client.execute({ sql: `SELECT month, SUM(amount) as total FROM cash_expenses WHERE month LIKE ? AND type = 'expense' GROUP BY month`, args: [`${year}-%`] }),
  ]);

  for (const r of sumRes.rows) {
    const s = r as unknown as MonthlySummary;
    summaries[s.month] = s;
  }

  balancesByMonth = await readMonthBalances(client, months);
  const investmentsRes = await client.execute({ sql: LATEST_INVESTMENTS_SQL, args: [prevMonth(months[0])] });
  if (investmentsRes.rows.length) investmentsSeed = Number((investmentsRes.rows[0] as any).investments_value);

  // Index payments by "month|bill_id"
  const payMap = new Map<string, { amount: number; is_skipped: number }>();
  for (const r of payRes.rows as unknown as any[]) {
    payMap.set(`${r.month}|${r.bill_id}`, { amount: Number(r.amount), is_skipped: Number(r.is_skipped) });
  }

  // For each month in the year, resolve every recurring bill's amount
  const configs = configRes.rows as unknown as { id: string; name: string; monthly_target: number | null; is_cc_default: number; start_month: string | null; end_month: string | null }[];
  for (const mo of months) {
    billsByMonth[mo] = configs
      .map(bc => {
        if (bc.start_month && mo < bc.start_month) return null;
        if (bc.end_month   && mo > bc.end_month)   return null;
        const pay = payMap.get(`${mo}|${bc.id}`);
        if (pay?.is_skipped) return null;
        const actual_amount = pay ? pay.amount : Number(bc.monthly_target ?? 0);
        return { id: bc.id, name: bc.name, actual_amount, is_cc: Number(bc.is_cc_default) };
      })
      .filter((b): b is NonNullable<typeof b> => b !== null);
  }

  for (const r of ccRes.rows as unknown as CCCharge[]) {
    if (!ccByMonth[r.month]) ccByMonth[r.month] = [];
    ccByMonth[r.month].push(r);
  }
  for (const r of ccVarRes.rows as unknown as { month: string; total: number }[]) {
    ccVariableByMonth[r.month] = Number(r.total);
  }
  bigPurchaseRows = bigRes.rows as unknown as typeof bigPurchaseRows;
  for (const r of cashIncomeRes.rows as unknown as { month: string; total: number }[]) {
    cashIncomeByMonth[r.month] = Number(r.total);
  }
  const settingsRow = ccSettingsRes.rows[0] as unknown as { day: number } | undefined;
  if (settingsRow?.day) billingEndDay = Number(settingsRow.day);
  for (const r of cashExpenseRes.rows as unknown as { month: string; total: number }[]) {
    cashExpenseByMonth[r.month] = Number(r.total);
  }
} finally { client.close(); }

const amort = amortizeBigPurchases(bigPurchaseRows, months.filter(m => m <= String(new Date().toISOString().slice(0,7))).length || 12);

function getOrEmpty(month: string): MonthlySummary {
  return summaries[month] ?? { month, income_alex:0,income_maham:0,income_other:0,checking_before:0,checking_after:0,savings_before:0,savings_after:0,cc_budget:5000,notes:null };
}

const today = new Date();
// Highlighted (and scrolled-to) column; -1 when viewing another year.
const currentIdx = Number(year) === today.getFullYear() ? today.getMonth() : -1;

// Grid cells drop cents so 14 columns stay readable on a phone; the rest of the page keeps fmt().
const usd0 = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
function cell(n: number): string {
  return usd0.format(Math.round(n) || 0);
}

// Averages count only elapsed months that have a value, so blank future months don't drag them down.
const thisMonth = today.toISOString().slice(0, 7);

// Investments are typed values, carried forward through blank months.
const investmentsByMonth: Record<string, number> = {};
{
  let last = investmentsSeed;
  for (const m of months) {
    const typed = getOrEmpty(m).investments_value;
    if (typed !== null && typed !== undefined) last = Number(typed);
    investmentsByMonth[m] = last;
  }
}
function avgOf(values: number[]): number {
  const vs = values.filter((v, i) => months[i] <= thisMonth && v !== 0);
  return vs.length ? vs.reduce((a, b) => a + b, 0) / vs.length : 0;
}
function avgCell(values: number[]): string {
  const a = avgOf(values);
  return a ? cell(a) : '—';
}

function ccSpend(month: string): number {
  const [y, mo] = month.split('-').map(Number);
  const billingCutoff = new Date(y, mo - 1, billingEndDay);
  if (today < billingCutoff) {
    return Number(getOrEmpty(month).cc_budget ?? 0);
  }
  return ccVariableByMonth[prevMonth(month)] ?? 0;
}
const CC_PAYMENT_PATTERN = /cc\s*payment|credit\s*card\s*payment/i;
function checkingOut(month: string): number {
  return (billsByMonth[month] ?? [])
    .filter((b: any) => !b.is_cc && !CC_PAYMENT_PATTERN.test(b.name))
    .reduce((s: number, b: any) => s + Number(b.actual_amount), 0);
}
function otherIncome(month: string): number {
  return cashIncomeByMonth[month] ?? 0;
}
function cashExpense(month: string): number {
  return cashExpenseByMonth[month] ?? 0;
}
function netForMonth(month: string): number {
  const s = getOrEmpty(month);
  return totalIncome(s) + otherIncome(month) - checkingOut(month) - ccSpend(month) - cashExpense(month);
}
---

<Layout title={`${year} Budget — Year View`} wide={true}>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <a href={`/budget/year?year=${Number(year)-1}`} class="rounded-lg border border-surface-border px-3 py-1.5 text-sm text-stone-500 hover:text-stone-800">←</a>
      <h1 class="text-xl font-semibold text-stone-800">{year} Overview</h1>
      <a href={`/budget/year?year=${Number(year)+1}`} class="rounded-lg border border-surface-border px-3 py-1.5 text-sm text-stone-500 hover:text-stone-800">→</a>
    </div>
    <div class="flex gap-2">
      <a href="/budget" class="rounded-lg border border-surface-border px-3 py-1.5 text-sm text-stone-500 hover:text-stone-800">Monthly View</a>
      <a href={`/api/budget/export?year=${year}`} class="rounded-lg border border-surface-border px-3 py-1.5 text-sm text-stone-500 hover:text-stone-800">Export XLSX</a>
    </div>
  </div>

  <div class="overflow-auto max-h-[calc(100dvh-11rem)] rounded-xl border border-surface-border" data-year-scroll>
    <table class="year-grid w-full text-xs">
      <thead>
        <tr class="border-b border-surface-border bg-surface-card">
          <th class="px-3 py-3 text-left font-medium text-stone-400 w-36">Category</th>
          {MONTH_NAMES.map((m, i) => (
            <th class={`px-2 py-3 text-right font-medium ${i === currentIdx ? 'text-brand-green' : 'text-stone-400'}`} data-current={i === currentIdx ? '' : undefined}>
              <a href={`/budget?month=${months[i]}`} class="inline-block py-1 hover:text-brand-green">{m}</a>
            </th>
          ))}
          <th class="px-3 py-3 text-right font-medium text-stone-400">Avg</th>
          <th class="px-3 py-3 text-right font-medium text-stone-400">Total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-surface-border bg-surface-card">
        {/* Income rows */}
        {[
          { label: 'Alex Income',  values: months.map(m => Number(getOrEmpty(m).income_alex ?? 0)) },
          { label: 'Maham Income', values: months.map(m => Number(getOrEmpty(m).income_maham ?? 0)) },
          { label: 'Other Income', values: months.map(m => otherIncome(m)) },
        ].map(({ label, values }) => {
          const total = values.reduce((a, b) => a + b, 0);
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-2 text-stone-500">{label}</td>
              {values.map((v) => (
                <td class="px-2 py-2 text-right tabular-nums text-brand-green">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-2 text-right tabular-nums font-medium text-brand-green">{total ? cell(total) : '—'}</td>
            </tr>
          );
        })}

        {/* Separator */}
        <tr><td colspan="15" class="py-0 bg-surface-hover h-px"></td></tr>

        {/* Checking out */}
        {(() => {
          const values = months.map(m => checkingOut(m));
          const total  = values.reduce((a,b)=>a+b,0);
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-2 text-stone-500">
                <span class="relative group inline-flex items-center gap-1 outline-none" tabindex="0">
                  Fixed Bills
                  <span class="text-stone-300 text-xs cursor-help">ⓘ</span>
                  <span class="pointer-events-none absolute bottom-full left-0 mb-1.5 hidden group-hover:block group-focus:block w-64 rounded bg-stone-800 px-2 py-1.5 text-xs text-white z-10">
                    Cash expenses that are fixed recurring bills — mortgage, utilities, and other bills always paid in cash.
                  </span>
                </span>
              </td>
              {values.map(v => (
                <td class="px-2 py-2 text-right tabular-nums text-stone-600">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-2 text-right tabular-nums font-medium text-stone-600">{total ? cell(total) : '—'}</td>
            </tr>
          );
        })()}

        {/* CC spend */}
        {(() => {
          const values = months.map(m => ccSpend(m));
          const total  = values.reduce((a,b)=>a+b,0);
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-2 text-stone-500">
                <span class="relative group inline-flex items-center gap-1 outline-none" tabindex="0">
                  CC Spend
                  <span class="text-stone-300 text-xs cursor-help">ⓘ</span>
                  <span class="pointer-events-none absolute bottom-full left-0 mb-1.5 hidden group-hover:block group-focus:block w-64 rounded bg-stone-800 px-2 py-1.5 text-xs text-white z-10">
                    Total credit card usage — includes food, shopping, and everything else that is not a fixed bill.
                  </span>
                </span>
              </td>
              {values.map(v => (
                <td class="px-2 py-2 text-right tabular-nums text-stone-600">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-2 text-right tabular-nums font-medium text-stone-600">{total ? cell(total) : '—'}</td>
            </tr>
          );
        })()}

        {/* Cash Expenses */}
        {(() => {
          const values = months.map(m => cashExpense(m));
          const total  = values.reduce((a,b)=>a+b,0);
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-2 text-stone-500">
                <span class="relative group inline-flex items-center gap-1 outline-none" tabindex="0">
                  Unaccounted Cash Expenses
                  <span class="text-stone-300 text-xs cursor-help">ⓘ</span>
                  <span class="pointer-events-none absolute bottom-full left-0 mb-1.5 hidden group-hover:block group-focus:block w-64 rounded bg-stone-800 px-2 py-1.5 text-xs text-white z-10">
                    One-off cash outflows entered manually — separate from fixed recurring bills (rent, utilities, etc.)
                  </span>
                </span>
              </td>
              {values.map(v => (
                <td class="px-2 py-2 text-right tabular-nums text-stone-600">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-2 text-right tabular-nums font-medium text-stone-600">{total ? cell(total) : '—'}</td>
            </tr>
          );
        })()}

        {/* CC Budget */}
        {(() => {
          const values = months.map(m => Number(getOrEmpty(m).cc_budget));
          const total  = values.reduce((a,b)=>a+b,0);
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-2 text-stone-400">
                <span class="relative group inline-flex items-center gap-1 outline-none" tabindex="0">
                  CC Budget
                  <span class="text-stone-300 text-xs cursor-help">ⓘ</span>
                  <span class="pointer-events-none absolute bottom-full left-0 mb-1.5 hidden group-hover:block group-focus:block w-64 rounded bg-stone-800 px-2 py-1.5 text-xs text-white z-10">
                    The planned spending limit set for each month's credit card cycle. Used as the CC Spend estimate for months whose billing date hasn't passed yet.
                  </span>
                </span>
              </td>
              {values.map(v => (
                <td class="px-2 py-2 text-right tabular-nums text-stone-400">{cell(v)}</td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-2 text-right tabular-nums text-stone-400">{cell(total)}</td>
            </tr>
          );
        })()}

        {/* Separator */}
        <tr><td colspan="15" class="py-0 bg-surface-hover h-px"></td></tr>

        {/* Checking After */}
        {(() => {
          const values = months.map(m => Number(getOrEmpty(m).checking_after));
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-2 text-stone-500">Checking (After)</td>
              {values.map(v => (
                <td class="px-2 py-2 text-right tabular-nums text-stone-600">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-2 text-right tabular-nums text-stone-400">—</td>
            </tr>
          );
        })()}

        {/* Savings After */}
        {(() => {
          const values = months.map(m => Number(getOrEmpty(m).savings_after));
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-2 text-stone-500">Savings (After)</td>
              {values.map(v => (
                <td class="px-2 py-2 text-right tabular-nums text-stone-600">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-2 text-right tabular-nums text-stone-400">—</td>
            </tr>
          );
        })()}

        {/* Monthly sweep to the money market (excludes the one-time move) */}
        {(() => {
          const values = months.map(m => balancesByMonth.get(m)?.sweep ?? 0);
          const total = values.reduce((a,b)=>a+b,0);
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-2 text-stone-500">Monthly sweep</td>
              {values.map(v => (
                <td class="px-2 py-2 text-right tabular-nums text-stone-600">
                  {v ? cell(v) : <span class="text-stone-300">—</span>}
                </td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-2 text-right tabular-nums font-medium text-stone-600">{total ? cell(total) : '—'}</td>
            </tr>
          );
        })()}

        {/* Money market after */}
        {(() => {
          const values = months.map(m => balancesByMonth.get(m)?.mmEnd ?? 0);
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-2 text-stone-500">Money Market (After)</td>
              {values.map(v => (
                <td class="px-2 py-2 text-right tabular-nums text-stone-600">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-2 text-right tabular-nums text-stone-400">—</td>
            </tr>
          );
        })()}

        {/* Investments: typed values, carried forward through blank months */}
        {(() => {
          const values = months.map(m => investmentsByMonth[m]);
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-2 text-stone-500">Investments</td>
              {values.map(v => (
                <td class="px-2 py-2 text-right tabular-nums text-stone-600">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-2 text-right tabular-nums text-stone-400">—</td>
            </tr>
          );
        })()}

        {/* Separator before summary */}
        <tr><td colspan="15" class="py-0 bg-surface-hover h-px"></td></tr>

        {/* Total Income summary */}
        {(() => {
          const values = months.map(m => { const s = getOrEmpty(m); return totalIncome(s) + otherIncome(m); });
          const total  = values.reduce((a,b)=>a+b,0);
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-1.5 text-xs text-stone-400">Total Income</td>
              {values.map(v => (
                <td class="px-2 py-1.5 text-right tabular-nums text-xs text-stone-500">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-1.5 text-right tabular-nums text-xs text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-1.5 text-right tabular-nums text-xs font-medium text-stone-500">{total ? cell(total) : '—'}</td>
            </tr>
          );
        })()}

        {/* Total Expenses summary */}
        {(() => {
          const values = months.map(m => checkingOut(m) + ccSpend(m) + cashExpense(m));
          const total  = values.reduce((a,b)=>a+b,0);
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-1.5 text-xs text-stone-400">Total Expenses</td>
              {values.map(v => (
                <td class="px-2 py-1.5 text-right tabular-nums text-xs text-stone-500">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-1.5 text-right tabular-nums text-xs text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-1.5 text-right tabular-nums text-xs font-medium text-stone-500">{total ? cell(total) : '—'}</td>
            </tr>
          );
        })()}

        {/* Total cash: the same balances as the rows above; blank for months without a ledger row */}
        {(() => {
          const values = months.map(m => {
            const b = balancesByMonth.get(m);
            if (!b) return 0;
            const s = getOrEmpty(m);
            return Number(s.checking_after) + Number(s.savings_after) + b.mmEnd + investmentsByMonth[m];
          });
          return (
            <tr class="hover:bg-surface-hover">
              <td class="px-3 py-1.5 text-xs text-stone-400">Total Cash (End of Month)</td>
              {values.map(v => (
                <td class="px-2 py-1.5 text-right tabular-nums text-xs text-stone-500">{v ? cell(v) : <span class="text-stone-300">—</span>}</td>
              ))}
              <td class="px-3 py-1.5 text-right tabular-nums text-xs text-stone-500">{avgCell(values)}</td>
              <td class="px-3 py-1.5 text-right tabular-nums text-xs text-stone-400">—</td>
            </tr>
          );
        })()}

        {/* Net (pre-savings) */}
        {(() => {
          const values = months.map(m => netForMonth(m));
          const total  = values.reduce((a,b)=>a+b,0);
          return (
            <tr class="border-t-2 border-surface-border hover:bg-surface-hover font-medium">
              <td class="px-3 py-2 text-stone-600">Net (pre-savings)</td>
              {values.map(v => (
                <td class={`px-2 py-2 text-right tabular-nums ${v > 0 ? 'text-brand-green' : v < 0 ? 'text-brand-red' : 'text-stone-400'}`}>
                  {v !== 0 ? cell(v) : <span class="text-stone-300">—</span>}
                </td>
              ))}
              <td class={`px-3 py-2 text-right tabular-nums ${avgOf(values) > 0 ? 'text-brand-green' : avgOf(values) < 0 ? 'text-brand-red' : 'text-stone-400'}`}>{avgCell(values)}</td>
              <td class={`px-3 py-2 text-right tabular-nums ${total > 0 ? 'text-brand-green' : total < 0 ? 'text-brand-red' : 'text-stone-400'}`}>{cell(total)}</td>
            </tr>
          );
        })()}
      </tbody>
    </table>
  </div>

  <p class="mt-3 text-xs text-stone-400">Tap any month header to open the detail view. Amounts are rounded to the dollar. Avg = mean of months so far that have a value. Net (pre-savings) = income − fixed bills − CC spend. Monthly sweep excludes the one-time move. Total Cash = checking + savings + money market + investments.</p>

  {amort.grandTotal > 0 && (
    <div class="mt-8 rounded-xl border border-surface-border bg-surface-card p-5">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wide text-stone-400 mb-1">Big Purchases — {year}</h2>
          <div class="flex items-baseline gap-3 flex-wrap">
            <span class="text-2xl font-bold tabular-nums text-stone-800">{fmt(amort.grandTotal)}</span>
            <span class="text-sm text-stone-400">total · <span class="font-medium text-stone-600">{fmt(amort.monthlyAmortized)}/mo</span> amortized over {amort.windowMonths} months</span>
          </div>
        </div>
        <div class="text-right">
          <p class="text-xs text-stone-400">Annual reserve target</p>
          <p class="tabular-nums font-semibold text-stone-700">{fmt(amort.annualReserveTarget)}/yr</p>
        </div>
      </div>

      <div class="space-y-3">
        {amort.byCategory.map(cat => {
          const barPct = amort.grandTotal > 0 ? Math.min((cat.total / amort.grandTotal) * 100, 100) : 0;
          return (
            <div>
              <div class="flex items-center justify-between mb-1">
                <div class="flex items-center gap-2">
                  <span class="inline-block h-2.5 w-2.5 rounded-full flex-shrink-0" style={`background:${cat.color}`}></span>
                  <span class="text-sm font-medium text-stone-700">{cat.label}</span>
                  <span class="text-xs text-stone-400">×{cat.count}</span>
                </div>
                <div class="flex items-baseline gap-3 text-right">
                  <span class="text-xs text-stone-400">{fmt(cat.monthlyAmortized)}/mo</span>
                  <span class="tabular-nums text-sm font-medium text-stone-700 w-24">{fmt(cat.total)}</span>
                </div>
              </div>
              <div class="h-1.5 rounded-full bg-surface overflow-hidden">
                <div class="h-full rounded-full" style={`width:${barPct.toFixed(1)}%;background:${cat.color};opacity:0.7`}></div>
              </div>
            </div>
          );
        })}
      </div>

      <p class="mt-4 text-xs text-stone-400">
        Amortized over {amort.windowMonths} month{amort.windowMonths !== 1 ? 's' : ''} in {year}.
        Reserve target = monthly amortized × 12 — the annual set-aside to self-fund this pace.
      </p>
    </div>
  )}
</Layout>

<style>
  /* Row names and month headers stay put while the grid scrolls (14 columns don't fit a phone). */
  .year-grid :is(th, td) { white-space: nowrap; }
  .year-grid thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #f5f5ef;
    box-shadow: inset 0 -1px 0 #c0cab2;
  }
  .year-grid tr > :first-child:not([colspan]) {
    position: sticky;
    left: 0;
    z-index: 1;
    background: #f5f5ef;
    box-shadow: inset -1px 0 0 #c0cab2, 6px 0 8px -6px rgb(0 0 0 / 0.12);
    white-space: normal;
    min-width: 7.5rem;
    max-width: 9rem;
    line-height: 1.25;
  }
  .year-grid thead th:first-child { z-index: 3; box-shadow: inset -1px -1px 0 #c0cab2; }
  .year-grid tbody tr:hover > td:first-child { background: #e4e7db; }
</style>

{/* Current month column tint — nth-child can't take a CSS variable, so the index is rendered in. */}
{currentIdx >= 0 && (
  <style is:inline set:html={`.year-grid tbody tr > td:nth-child(${currentIdx + 2}):not([colspan]) { background: rgb(101 163 13 / 0.07); }`} />
)}

<script>
  // Open scrolled so the current month (with two months of context) sits right of the row names.
  const wrap = document.querySelector<HTMLElement>('[data-year-scroll]');
  const cur  = wrap?.querySelector<HTMLElement>('th[data-current]');
  if (wrap && cur && wrap.scrollWidth > wrap.clientWidth) {
    const first  = wrap.querySelector<HTMLElement>('th')!;
    const anchor = (cur.previousElementSibling?.previousElementSibling as HTMLElement | null) ?? cur;
    wrap.scrollLeft = Math.max(0, anchor.offsetLeft - first.offsetWidth);
  }
</script>
